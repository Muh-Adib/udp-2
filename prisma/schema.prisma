generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ORGANIZATION STRUCTURE ============

model Brand {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  color           String   @default("#f97316") // hex accent
  description     String?
  website         String?
  primaryCurrency String   @default("IDR")
  invoicePrefix   String   @default("INV")
  quotePrefix     String   @default("QUO")
  slaHours        Int      @default(4)
  portalDomain    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ==== Ronde 29-b — Identitas brand dari data asli situs ====
  logoUrl          String? // path aset publik ("/brands/logo-x.png") atau data URL upload
  // ==== Ronde 62 — Palet warna brand ====
  logoBg           String? // warna latar area logo (mis. "#0f172a") — logo berwarna putih (mis. Segia) tampil jelas; null = transparan/putih
  palette          String  @default("{}") // JSON palet warna brand {primary, accent, background, text} — dipakai form request & pratinjau
  tagline          String? // tagline resmi (mis. "Jagonya Buat Animasi")
  address          String? // alamat lengkap kantor
  city             String? // kota utama operasional
  phone            String? // telepon utama
  whatsappNumber   String? // nomor WA bisnis utama brand
  instagramHandle  String? // akun IG resmi (mis. @unimasi_)
  threadsHandle    String? // akun Threads resmi
  email            String? // email bisnis utama brand
  letterheadHeader String? // gambar kop surat atas (data URL ≤1.6MB)
  letterheadFooter String? // gambar kaki surat bawah (data URL)
  letterTemplate   String? // JSON style template surat {fontFamily, accentColor, headerStyle, showLogo, footerNote}

  // ==== Ronde 50 — dokumen resmi: kode brand, faktur, penanda tangan, aset per jenis surat ====
  shortCode     String? // kode singkat utk penomoran (mis. "UDP" → 002/QT-UDP/I/26)
  npwp          String? // NPWP perusahaan (tampil di faktur)
  bankAccounts  String  @default("[]") // JSON [{bank, number, holder, branch}] — blok "Payment to" faktur
  signerName    String? // nama penanda tangan dokumen (mis. "Andri Saputro")
  signerClosing String? // salam penutup dokumen (mis. "Best regards and enjoy the process,")
  docAssets     String  @default("{}") // JSON { quotation:{header,footer}, invoice:{header,footer} } — kop per jenis surat

  opportunities     Opportunity[]
  projects          Project[]
  invoices          Invoice[]
  interactions      Interaction[]
  quotations        Quotation[]
  briefs            ClientBrief[]
  channels          ChannelConfig[]
  serviceCategories ServiceCategory[]
  services          Service[]
  numberingRules    NumberingRule[]
  intakeLinks       LeadIntakeLink[]
  workflowTemplates WorkflowTemplate[]
  workPeriods       WorkPeriod[]
  expenseClaims     ExpenseClaim[]
}

/**
 * Ronde 57 — Shareable intake link per brand (Sales Pipeline).
 * Staf membuat link publik (tanpa login) — calon lead mengisi form request:
 * data perusahaan (dgn alamat) + kontak + judul project + deadline + brief awal.
 * Server otomatis membuat/duplikasi-dedupe Company+Contact, membuat Opportunity
 * (stage new, expected close: deadline-3 minggu / +1 hari bila mepet) dan draft
 * ClientBrief. URL = {origin}/?intake=<token>.
 */
model LeadIntakeLink {
  id               String    @id @default(cuid())
  token            String    @unique // 48 hex acak — rahasia, kunci akses publik
  brandId          String
  brand            Brand     @relation(fields: [brandId], references: [id])
  label            String?   // mis. "Iklan IG Mei 2026", "Follow-up event"
  active           Boolean   @default(true) // false = link dimatikan
  createdByName    String?
  submissionCount  Int       @default(0)
  lastSubmissionAt DateTime?
  lastAccessedAt   DateTime? // terakhir dibuka form-nya (meta analitik ringan)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([brandId])
}

/**
 * Ronde 50 — SISTEM PENOMORAN DOKUMEN per brand per jenis surat.
 * Template dgn token: {SEQ:n} {DOC} {BRAND} {ROMAN} {roman} {MM} {YY} {YYYY}
 * Contoh hasil: 002/QT-UDP/I/26 (template "{SEQ:3}/{DOC}-{BRAND}/{ROMAN}/{YY}").
 * Revisi dokumen → sufiks pada SEQ: 012 → 012-1 → 012-2.
 */
model NumberingRule {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  docType     String // quotation | invoice
  template    String   @default("{SEQ:3}/{DOC}-{BRAND}/{ROMAN}/{YY}")
  docCode     String   @default("QT") // token {DOC} — mis. QT / INV
  resetPeriod String   @default("yearly") // never | yearly | monthly
  resetKey    String   @default("") // "2026" / "2026-01" — penanda periode counter terakhir
  seq         Int      @default(0) // counter terakhir terpakai (nomor berikutnya = seq+1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, docType])
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   @default("marketing") // super_admin, director, manager, hr, marketing, finance, production, client
  pin         String   @default("1234") // PIN untuk membuka kunci layar sesi (scrypt)
  password    String? // hash scrypt password login (null = akun legacy, login via PIN)
  avatarColor String   @default("#f97316")
  phone       String?
  active      Boolean  @default(true)
  brandAccess String   @default("all") // "all" or comma-separated brand slugs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee?
}

// ============ IDENTITY (company-centric & contact-centric) ============

model Company {
  id              String    @id @default(cuid())
  name            String
  industry        String?
  website         String?
  websiteDomain   String? // normalized for matching
  country         String?
  city            String?
  address         String?
  size            String? // startup, sme, enterprise, government
  taxId           String?
  defaultCurrency String    @default("IDR")
  lifetimeValue   Float     @default(0)
  tags            String    @default("[]") // JSON array
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  projects      Project[]
  invoices      Invoice[]
  quotations    Quotation[]
  portalTokens  ClientPortalToken[]
  documents     ClientDocument[]
}

model Contact {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String?
  fullName         String // computed & stored for search
  position         String?
  email            String? // normalized lowercase
  emailAlt         String?
  whatsapp         String? // normalized E.164 digits
  phone            String?
  country          String?
  currency         String? // Ronde 41: mata uang preferensi kontak (ISO 4217) — fallback mata uang opportunity/brief/quotation/invoice
  city             String?
  timezone         String?
  language         String    @default("id")
  preferredChannel String    @default("whatsapp") // whatsapp, email, phone, instagram
  socialProfile    String? // handle/URL sosial lain (bebas)
  instagram        String? // handle IG (mis. @rani.creativehouse) — lead kerap datang dari IG
  facebook         String?
  tiktok           String?
  linkedin         String?
  consentStatus    String    @default("granted") // granted, declined, pending
  tags             String    @default("[]") // JSON array
  notes            String?
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  opportunities Opportunity[]
  interactions  Interaction[]
}

// ============ SALES ============

model Opportunity {
  id                String    @id @default(cuid())
  title             String
  brandId           String
  brand             Brand     @relation(fields: [brandId], references: [id])
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id])
  serviceCategory   String? // animation, website, video, immersive...
  serviceName       String?
  leadSource        String? // instagram, whatsapp, email, website, referral, event
  campaign          String?
  brief             String?
  requirements      String?
  targetAudience    String?
  deliverables      String?
  targetDeadline    DateTime?
  estimatedValue    Float?
  currency          String    @default("IDR")
  probability       Int       @default(20)
  expectedCloseDate DateTime?
  ownerName         String?
  priority          String    @default("medium") // low, medium, high, urgent
  stage             String    @default("new") // new, contact_attempted, connected, qualified, discovery, estimation, proposal_sent, negotiation, verbal_agreement, won, lost, nurture
  temperature       String    @default("warm") // hot, warm, cold
  competitor        String?
  nextAction        String?
  nextActionDate    DateTime?
  lostReason        String?
  lostNotes         String?
  lastOfferValue    Float?
  reactivation      Boolean   @default(false)
  followUpDate      DateTime?
  nurtureSegment    String? // reoffer_30, reoffer_90, budget_season, cross_sell, smaller_package, alternative_service
  crossSellOfId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  interactions Interaction[]
  tasks        Task[]
  notes        Note[]
  projects     Project[]
  invoices     Invoice[]
  estimation   Estimation?
  quotations   Quotation[]
  approvals    ApprovalRequest[]
  clientBrief  ClientBrief?
}

model Interaction {
  id             String       @id @default(cuid())
  channel        String // whatsapp, email, instagram, website, phone, meeting, portal
  direction      String // inbound, outbound
  brandId        String?
  externalId     String?
  senderName     String?
  recipientName  String?
  subject        String?
  content        String
  attachments    String? // JSON array
  respondedBy    String?
  respondedAt    DateTime?
  deliveryStatus String? // delivered, read, failed, sent
  deliveryNote   String? // catatan pengiriman nyata (error SMTP, dsb)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  companyId      String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  createdAt      DateTime     @default(now())
  // Ronde 61 — hapus dari inbox = SOFT DELETE (arsip): disembunyikan dari semua
  // tampilan inbox; masih bisa dipulihkan dari tab Arsip atau dihapus permanen.
  archivedAt     DateTime?

  // Ronde 36 (audit): index utk filter inbox/timeline yang tumbuh paling cepat
  @@index([contactId])
  @@index([opportunityId])
  @@index([externalId])
  @@index([createdAt])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          String       @default("follow_up") // follow_up, meeting, internal, admin
  priority      String       @default("medium") // low, medium, high
  status        String       @default("open") // open, done, cancelled
  assigneeName  String? // assignee utama (kompatibilitas; = assignees[0])
  assignees     String       @default("[]") // Ronde 40: JSON array nama assignee (multi-tag)
  attachments   String       @default("[]") // Ronde 40: JSON [{type:"link"|"file", name, url, size?}] (file ≤5MB)
  dueDate       DateTime?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  // Ronde 52 — task produksi: bisa menempel ke project & milestone timeline
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Ronde 36 (audit): index utk daftar follow-up & timeline opportunity
  @@index([opportunityId])
  @@index([status, dueDate])
  @@index([projectId])
}

model Note {
  id            String      @id @default(cuid())
  body          String
  authorName    String
  type          String      @default("internal") // internal, director_feedback
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  createdAt     DateTime    @default(now())
}

// ============ FINANCE ============

model Invoice {
  id              String         @id @default(cuid())
  number          String         @unique
  brandId         String
  brand           Brand          @relation(fields: [brandId], references: [id])
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  changeRequestId String?        @unique
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id])
  description     String?
  amount          Float          @default(0)
  taxRate         Float          @default(11) // PPN %
  taxName         String? // Ronde 40: nama pajak bebas (PPN, PPh 21, dll; null = tanpa pajak)
  taxAmount       Float          @default(0)
  total           Float          @default(0)
  currency        String         @default("IDR")
  status          String         @default("draft") // draft, sent, partial, paid, overdue, cancelled
  // ==== Ronde 50 — format faktur (gaya Unicam): item baris, DP, pajak potong, revisi ====
  items           String         @default("[]") // JSON [{description, qty, unit, unitPrice, total}]
  downPaymentPct  Float          @default(0) // >0 → baris "Down Payment (N%)", total dibayar = DP − pajak potong
  taxMode         String         @default("add") // add (PPN ditambahkan) | withhold (PPh dipotong) | grossup (Ronde 56: Gross-Up lalu Less — Total Payment = dasar)
  discountAmount  Float          @default(0) // Ronde 56 — diskon nominal (baris "Discount" gaya Unicam)
  terms           String? // Ronde 56 — JSON jadwal pembayaran [{label, pct, dueDays, dueEvent}] dueEvent: invoice|down_payment|bastp|handover|delivery
  purchaseNumber  String? // nomor PO klien ("Purchase Number")
  projectName     String? // label project di faktur (mis. "AI Video")
  attn            String? // personel klien di faktur
  clientAddress   String? // alamat klien di faktur (override alamat perusahaan)
  baseNumber      String? // nomor dasar tanpa sufiks revisi (mis. 004/INV-UDP/I/26)
  seqNo           Int     @default(0) // nilai SEQ terpakai saat nomor dibuat
  revisionOfId    String?
  revisionOf      Invoice?       @relation("InvoiceRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions       Invoice[]      @relation("InvoiceRevision")
  revisionNo      Int            @default(0) // 0 = bukan revisi; N = revisi ke-N
  revisionReason  String?
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments Payment[]

  // Ronde 36 (audit): index utk aging & tagihan per project
  @@index([projectId])
  @@index([dueDate])
  @@index([status])
  @@index([revisionOfId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    String   @default("transfer") // transfer, cash, qris, credit_card
  reference String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

// ============ PRODUCTION ============

model Project {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id])
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  opportunityId   String?      @unique
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  serviceCategory String?
  status          String       @default("planning") // planning, in_progress, review, completed, cancelled
  progress        Int          @default(0)
  pmName          String?
  poNumber        String? // Ronde 56 — nomor PO klien (salah satu pemicu status WON)
  startDate       DateTime?
  dueDate         DateTime?
  budgetInternal  Float        @default(0)
  contractValue   Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  milestones    Milestone[]
  invoices      Invoice[]
  changeRequests ChangeRequest[]
  deliverables  ProjectDeliverable[]
  tasks         Task[]
  // Ronde 48 — brief klien yang menghasilkan project ini (alur Won).
  brief         ClientBrief?
  // ERP: work engine & biaya per proyek
  workflowInstances WorkflowInstance[]
  workPeriods       WorkPeriod[]
  dailyLogs         DailyLog[]
  expenseClaims     ExpenseClaim[]
}

/**
 * Deliverable & file/tautan untuk direview — alur "kirim file/tautan ke sistem untuk ditinjau".
 * kind: link (url eksternal, contoh Google Drive/Figma) atau file (upload kecil ≤1.2MB, base64 data URL).
 * status: pending (menunggu review) → approved (disetujui) / revision (minta revisi + komentar).
 */
model ProjectDeliverable {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String? // Ronde 35 — opsional: deliverable ini untuk milestone mana (timeline produksi)
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  name          String
  kind          String   @default("link") // link | file
  url           String? // untuk kind=link
  fileName      String? // untuk kind=file
  fileData      String? // data URL base64 (upload kecil)
  mimeType      String?
  sizeBytes     Int?
  note          String?
  status        String   @default("pending") // pending, approved, revision
  reviewComment String?
  reviewedBy    String?
  reviewedRole  String? // production, director, super_admin, client (siapa yang mereview)
  reviewedAt    DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())

  versions DeliverableVersion[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  // Ronde 50 — cascade: hapus project ikut menghapus milestone (dulu bisa yatim → /api/dashboard 500).
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  status      String    @default("pending") // pending, in_progress, done
  dueDate     DateTime?
  achievement String? // Ronde 35 — apa yang dicapai/diserahkan pada milestone ini
  // Ronde 52 — breakdown pekerjaan dari estimasi: PIC, estimasi waktu, dan paralel
  picName     String? // siapa yang bertanggung jawab atas tahap ini
  durationDays Int?   // estimasi waktu tahap ini (hari kerja) — dasar hitung timeline
  parallel    Boolean @default(false) // tahap berjalan paralel dgn tahap sebelumnya
  createdAt   DateTime  @default(now())

  deliverables ProjectDeliverable[]
  tasks        Task[]
}

model ChangeRequest {
  id             String    @id @default(cuid())
  number         String    @unique // CR-2026-0001
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  title          String
  description    String
  additionalCost Float     @default(0) // tambahan nilai kontrak (net, sebelum PPN)
  additionalDays Int       @default(0) // perpanjangan deadline (hari kalender)
  status         String    @default("pending") // pending, approved, rejected, cancelled
  requestedBy    String
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?
  invoiceId      String? // invoice tambahan yang dibuat otomatis saat approved
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoice        Invoice?
}

// ============ GOVERNANCE ============

model AuditLog {
  id          String   @id @default(cuid())
  actorName   String
  actorRole   String?
  action      String // create, update, delete, stage_change, merge, login, convert
  entity      String // opportunity, contact, company, task, invoice, project, interaction
  entityId    String
  entityLabel String?
  field       String?
  oldValue    String?
  newValue    String?
  metadata    String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Ronde 36 (audit): index utk urutan audit terbaru
  @@index([createdAt])
  @@index([entity, entityId])
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  name      String
  brandId   String?
  channel   String   @default("whatsapp")
  language  String   @default("id")
  stage     String?
  delayDays Int      @default(1)
  body      String
  version   Int      @default(1)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ FASE 2: KOMERSIAL ============

model Estimation {
  id               String      @id @default(cuid())
  opportunityId    String      @unique
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
  // Cost breakdown kategori (IDR)
  laborInternal    Float       @default(0)
  vendorFreelance  Float       @default(0)
  equipment        Float       @default(0)
  transport        Float       @default(0)
  accommodation    Float       @default(0)
  talent           Float       @default(0)
  locationFee      Float       @default(0)
  softwareLicense  Float       @default(0)
  hostingDomain    Float       @default(0)
  costItems        String      @default("[]") // Ronde 40: JSON [{name, qty, days?, unitPrice, subtotal}] — rincian biaya per item (LEGACY, digantikan costCategories)
  // Ronde 49 — RAB bertingkat: kategori → item. JSON [{name, items: [{name, qty, unit, price, subtotal}], total}]
  costCategories   String      @default("[]")
  currency         String      @default("IDR") // mata uang harga (IDR/USD/SGD/EUR/...)
  fxRate           Float? // kurs currency→IDR yang dipakai saat disimpan (sinkron API free)
  fxSource         String? // sumber & waktu kurs, mis. "open.er-api.com · 10 Sep 2026 09:15" atau "fallback"
  contingencyPct   Float       @default(5)
  managementFeePct Float       @default(5)
  discountPct      Float       @default(0)
  taxPct           Float       @default(11)
  taxName          String? // Ronde 40: nama pajak bebas (PPN, PPh 21, dll; null = tanpa pajak)
  targetMarginPct  Float       @default(30)
  // Hasil kalkulasi (disimpan saat save)
  totalCost        Float       @default(0)
  contingency      Float       @default(0)
  managementFee    Float       @default(0)
  revenue          Float? // Ronde 41: nullable — harga penawaran bisa "belum diketahui" (null) sebelum diisi
  discountAmount   Float       @default(0)
  netRevenue       Float       @default(0)
  taxAmount        Float       @default(0)
  grandTotal       Float       @default(0)
  margin           Float       @default(0)
  marginPct        Float       @default(0)
  notes            String?
  status           String      @default("draft") // draft, pending_approval, approved, rejected
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Quotation {
  id             String      @id @default(cuid())
  number         String      @unique
  brandId        String
  brand          Brand       @relation(fields: [brandId], references: [id])
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  items          String      @default("[]") // JSON [{description, qty, unitPrice, subtotal}]
  subtotal       Float       @default(0)
  discountPct    Float       @default(0)
  discountAmount Float       @default(0)
  taxPct         Float       @default(11)
  taxName        String? // Ronde 40: nama pajak bebas (PPN, PPh 21, dll; null = tanpa pajak)
  taxAmount      Float       @default(0)
  total          Float       @default(0)
  currency       String      @default("IDR")
  status         String      @default("draft") // draft, sent, accepted, rejected, expired
  // ==== Ronde 56 — tanda tangan elektronik klien (secure share link) ====
  signedAt         DateTime? // waktu klien menandatangani via link aman
  signedByName     String? // nama penanda tangan (diisi klien)
  signedByTitle    String? // jabatan penanda tangan (opsional)
  signatureImage   String? // gambar tanda tangan klien (data URL, ≤600KB)
  shareTokens      QuotationShareToken[]
  // Ronde 39 — riwayat revisi: quotation revisi menunjuk quotation yang direvisi
  revisionOfId   String?
  revisionOf     Quotation?  @relation("QuotationRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions      Quotation[] @relation("QuotationRevision")
  revisionNo     Int         @default(0) // 0 = bukan revisi; N = revisi ke-N dari quotation sumber
  // ==== Ronde 50 — format surat penawaran (gaya Unicam) + nomor revisi 012 → 012-1 ====
  baseNumber     String? // nomor dasar tanpa sufiks revisi (mis. 012/QT-UDP/I/26)
  seqNo          Int     @default(0) // nilai SEQ terpakai saat nomor dibuat (utk render sufiks revisi di posisi SEQ)
  attachment     Int     @default(1) // "Attachment: 1"
  regarding      String? // perihal surat (mis. "Quotation of Short Film")
  attn           String? // personel klien yang dituju (Attn.)
  clientAddress  String? // alamat klien di surat (override alamat perusahaan)
  letterBody     String? // isi surat custom (paragraf, newline dgn \n); null = default otomatis
  letterClosing  String? // paragraf penutup custom; null = default otomatis dari brand
  timeline       String? // kolom Timeline (mis. "1 Month after down payment")
  revisionNotes  String? // kolom Revision — periode revisi hasil (mis. "Result Video: x2 per Video")
  termOfPayment  String? // kolom Term of Payment (mis. "1. Down Payment: 50%…"); otomatis di-generate dari terms bila jadwal terstruktur terisi
  terms          String? // Ronde 57 — JSON jadwal TOP terstruktur [{label,pct,dueDays,dueEvent}] (invoice|down_payment|bastp|handover|delivery); diwarisi Invoice.terms saat convert → jatuh tempo finance sinkron
  validUntil     DateTime?
  notes          String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([revisionOfId])
}

/**
 * Ronde 56 — token link aman quotation (secure share link).
 * - token  : identifier publik di URL (/?quote=<token>)
 * - keySha : SHA-256 dari "magic key" — magic link di email berisi key asli,
 *            server hanya membandingkan hash (key tidak pernah disimpan polos).
 * - passwordSha: SHA-256 password manual (fallback bila magic link hilang).
 * - maxOpens/opens: link aman terbatas dibuka 3× — habis → klien bisa minta
 *   kode baru (POST request-new-code) yang otomatis dikirim via email brand.
 */
model QuotationShareToken {
  id          String     @id @default(cuid())
  quotationId String
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  token       String     @unique
  keySha      String? // SHA-256 magic key (null = hanya password)
  passwordSha String? // SHA-256 password manual (null = hanya magic)
  maxOpens    Int        @default(3)
  opens       Int        @default(0)
  revoked     Boolean    @default(false)
  lastOpenedAt DateTime?
  createdBy   String?
  createdAt   DateTime   @default(now())

  @@index([quotationId])
}

model ApprovalRequest {
  id            String       @id @default(cuid())
  entityType    String // estimation, discount, budget
  entityId      String
  entityLabel   String?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  requestedBy   String
  amount        Float?
  discountPct   Float?
  note          String?
  status        String       @default("pending") // pending, approved, rejected
  decidedBy     String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())
}

// ============ NOTIFIKASI (Fase 3) ============
// State baca/dismiss per pengguna; isi notifikasi dikomputasi dari data
// operasional (SLA, approval, CR, task, deadline, invoice) di /api/notifications.
model NotificationState {
  id          String    @id @default(cuid())
  userKey     String // email user (persona demo) — kunci stabilitas per pengguna
  notifKey    String // kunci notifikasi komputasi, mis. "sla:<id>", "cr:<id>"
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userKey, notifKey])
  @@index([userKey])
}

// Ronde 39 — langganan Web Push (VAPID) per pengguna & perangkat.
// Satu pengguna bisa punya beberapa subscription (laptop + HP).
model PushSubscription {
  id        String   @id @default(cuid())
  userKey   String // email user dari sesi (bukan dari body)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userKey])
}

// ============ PREFERENSI PENGGUNA (Fase 3 — sinkron antar perangkat) ============
// KV store preferensi per pengguna; value berupa JSON string.
// Sumber kebenaran lintas perangkat (localStorage hanya cache instan/offline).
model UserPreference {
  id        String   @id @default(cuid())
  userKey   String // email user (persona demo) — kunci stabilitas per pengguna
  key       String // kunci preferensi, mis. "notif-prefs"
  value     String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userKey, key])
  @@index([userKey])
}

// ============ FASE 2: BRIEF BUILDER ============
// Brief terstruktur per opportunity — tahap pertama alur komersial
// (Brief → Estimasi → Quotation). Menggantikan brief teks bebas dgn
// struktur: layanan, tujuan, audiens, deliverables, timeline, budget,
// referensi + alur status draft → in_review → approved / revision.
model ClientBrief {
  id              String      @id @default(cuid())
  code            String      @unique // BRF-2026-0001
  opportunityId   String      @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  // Ronde 48 — brief ter-link ke project hasil Won (1:1) agar tim produksi
  // melihat brief klien langsung dari detail project tanpa membuka pipeline.
  projectId       String?     @unique
  project         Project?    @relation(fields: [projectId], references: [id])
  brandId         String
  brand           Brand       @relation(fields: [brandId], references: [id])
  title           String
  serviceTypes    String      @default("[]") // JSON array string (katalog layanan brand)
  objectives      String?
  targetAudience  String?
  keyMessages     String?
  keywords        String? // Ronde 57 — kata kunci brief dari form intake (bebas teks)
  deliverables    String      @default("[]") // JSON array [{name, qty, notes}]
  timelineStart   DateTime?
  timelineEnd     DateTime?
  budgetMin       Float?
  budgetMax       Float?
  currency        String      @default("IDR")
  references      String      @default("[]") // JSON array [{label, url}]
  attachmentsNote String?
  status          String      @default("draft") // draft, in_review, approved, revision
  revisionNote    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ============ FASE 3: PORTAL KLIEN — SECURE LINK TOKEN ============
// Akses klien TANPA login: staf membuat token rahasia per perusahaan klien,
// klien membuka URL /?portal=<token>. Token bisa dicabut kapan saja.
model ClientPortalToken {
  id             String    @id @default(cuid())
  token          String    @unique // 48 hex acak — rahasia, hanya dibagikan ke klien
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label          String?   // mis. "Hendra — PT Nusantara"
  active         Boolean   @default(true) // false = dicabut
  createdByName  String?
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

// Isi secure link klien: MoU (file/tautan), catatan rapat (teks), dokumen lain.
// File kecil ≤1.2MB disimpan base64 (praktis utk demo; object storage menyusul).
model ClientDocument {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String    @default("document") // mou | meeting_note | document
  title         String
  content       String?   // isi teks (catatan rapat / deskripsi dokumen)
  url           String?   // tautan eksternal (mis. Google Drive)
  fileName      String?
  fileData      String?   // data URL base64 (upload kecil)
  mimeType      String?
  sizeBytes     Int?
  meetingAt     DateTime? // utk kind=meeting_note
  attendees     String?   // peserta rapat, dipisah koma
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, kind])
}

// ============ KATALOG LAYANAN & WORKFLOW PRODUKSI (Ronde 29-b) ============
// Brand memiliki kategori layanan sendiri; tiap kategori berisi layanan;
// tiap layanan punya workflow produksi custom (fase + langkah, sebagian jadi
// milestone project). Contoh Unimasi: kategori "Animasi 3D" → layanan
// "Pembuatan Video Pembelajaran Anak Anak 3D" dengan flow
// Pra Production (Creative Concept & Story Board) → Production (milestone)
// → Post Production (milestone).
model ServiceCategory {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([brandId])
}

model Service {
  id          String          @id @default(cuid())
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  unit        String? // satuan penjualan (video, episode, proyek, bulan)
  basePrice   Float? // harga acuan (opsional)
  costItems   String? // JSON rincian biaya LEGACY [{name, amount, note?}] — digantikan costCategories
  costCategories String? // Ronde 52 — JSON kategori×item, struktur sama persis dgn RAB estimasi [{name, items:[{name,qty,unit,price,subtotal}], total}]
  targetMarginPct Float? // margin target % untuk saran harga (fallback 30)
  order       Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workflowStages WorkflowStage[]

  @@index([brandId])
  @@index([categoryId])
}

/**
 * Langkah workflow produksi per layanan. phase = nama fase bebas
 * (mis. "Pra Production", "Production", "Post Production"); isMilestone
 * menandai langkah yang tampil/terhitung sbg milestone saat project dibuat
 * dari opportunity.
 */
model WorkflowStage {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  phase       String   @default("Production")
  name        String
  description String?
  isMilestone Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
}

// ============ FASE 3: SALURAN & INTEGRASI ============
// Koneksi kanal komunikasi (WhatsApp Business, Instagram, Email) per brand
// atau organisasi. Kredensial disimpan JSON dan DIRESPONS TERSENSA oleh API.
// Webhook WhatsApp memakai verifyToken/appSecret dari sini sbg fallback env.
model ChannelConfig {
  id           String    @id @default(cuid())
  channel      String // whatsapp, instagram, threads, email, dll (lihat CHANNEL_TYPES)
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id])
  displayName  String
  accountRef   String? // nomor WA / username IG / alamat email
  credentials  String    @default("{}") // JSON per kanal (token, ids, secret)
  status       String    @default("connected") // connected, disconnected, error
  statusNote   String? // hasil test/verifikasi terakhir
  isDemo       Boolean   @default(false) // koneksi demo (kredensial buatan, 1-klik)
  lastEmailSyncAt DateTime? // sinkronisasi IMAP terakhir (kanal email)
  connectedAt  DateTime?
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([channel])
  @@index([brandId])
}

// Ronde 40 — parameter pajak bebas: nama + persentase (PPN, PPh 21, PPh 23, dll.)
model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Float    @default(11) // persentase pajak
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ronde 47 — RBAC dinamis: matriks hak akses per (role, modul) yang dapat
// dikonfigurasi admin dari UI (User & Access → Matriks Hak Akses), BUKAN hardcode.
// level: none (tidak bisa dibuka) | read (lihat saja) | write (buat/ubah) | full (write + aksi kritis)
model ModulePermission {
  id        String   @id @default(cuid())
  role      String // key role (lihat ROLES di lib/crm/constants.ts)
  module    String // key modul (lihat MODULE_META di lib/crm/store.ts)
  level     String   @default("read") // none, read, write, full
  updatedAt DateTime @updatedAt

  @@unique([role, module])
  @@index([role])
}

// ==================== ERP EXTENSION (Blueprint UDP Integrated Operations Platform v2.0) ====================
// Fase 3 Work Engine · Fase 5 HRIS · Fase 6 Compensation · Fase 7 Finance depth.
// Konvensi: String utk status/enum (SQLite), CUID id, Float uang (IDR), audit via logAudit.

// ============ FASE 3 — WORK ENGINE (workflow berversi + periode kerja) ============

// Template workflow produk (contoh: "Digmar — Siklus Konten Bulanan").
model WorkflowTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  brandId     String?
  brand       Brand?  @relation(fields: [brandId], references: [id])
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions WorkflowVersion[]
}

// Versi workflow — template berversi; instance lama TIDAK berubah saat versi baru publish.
model WorkflowVersion {
  id         String  @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id])
  version    Int
  status     String  @default("draft") // draft, published, archived
  note       String?
  publishedAt DateTime?
  createdAt  DateTime @default(now())

  steps    WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([templateId, version])
}

// Tahapan workflow dlm satu versi (urutan + SLA + role pelaksana).
model WorkflowStep {
  id         String @id @default(cuid())
  versionId  String
  version    WorkflowVersion @relation(fields: [versionId], references: [id])
  position   Int
  name       String
  kind       String  @default("task") // task, review, approval, publish
  roleNeeded String? // role pelaksana ideal (contoh production, finance)
  slaHours   Int?
}

// Instance workflow = pelaksanaan nyata satu pekerjaan mengikuti satu versi.
model WorkflowInstance {
  id           String  @id @default(cuid())
  versionId    String
  version      WorkflowVersion @relation(fields: [versionId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  workPeriodId String?
  workPeriod   WorkPeriod? @relation(fields: [workPeriodId], references: [id])
  title        String
  contextType  String  @default("project") // project, retainer, rnd, standalone
  status       String  @default("active") // active, done, cancelled
  currentPos   Int     @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  assigneeIds  String? // comma-separated userId pelaksana
}

// Periode kerja berulang utk kontrak retainer (Digmar dkk) — siklus bulanan/periodik.
model WorkPeriod {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  name      String
  periodStart DateTime
  periodEnd   DateTime
  status    String  @default("planned") // planned, active, closed
  contractRef String? // referensi PKS/agreement
  createdAt DateTime @default(now())

  instances WorkflowInstance[]
}

// Versi konten deliverable — post/reel/artikel: versioning + review internal & klien.
model DeliverableVersion {
  id            String @id @default(cuid())
  deliverableId String
  deliverable   ProjectDeliverable @relation(fields: [deliverableId], references: [id])
  version       Int
  content       String? // caption/naskah/link — utk file ikut deliverable induk
  url           String?
  status        String  @default("draft") // draft, internal_review, client_review, approved, published, revision
  feedback      String?
  reviewedBy    String? // reviewer internal
  clientReviewedBy String? // nama reviewer klien (claim)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@unique([deliverableId, version])
}

// ============ FASE 5 — HRIS ============

// Master karyawan; opsional terhubung User (staf tanpa login tetap mungkin).
model Employee {
  id              String  @id @default(cuid())
  userId          String? @unique
  user            User?   @relation(fields: [userId], references: [id])
  employeeNumber  String  @unique
  preferredName   String
  employmentStatus String @default("permanent") // permanent, intern, freelance
  department      String? // marketing, production, finance, hr
  position        String?
  supervisorId    String?
  supervisor      Employee? @relation("EmpSupervisor", fields: [supervisorId], references: [id])
  subordinates    Employee[] @relation("EmpSupervisor")
  joinedOn        DateTime?
  leftOn          DateTime?
  // Data magang
  internProgram   String?
  internStart     DateTime?
  internEnd       DateTime?
  stipendDaily    Float? // uang saku per hari hadir
  // Data sensitif (ACL: hr/director saja via API)
  bankName        String?
  bankAccount     String?
  umkRegion       String? // kode wilayah utk formula insentif
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendanceEvents AttendanceEvent[]
  leaveRequests    LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  travelOrders     TravelOrder[]
  dailyLogs        DailyLog[]
  payslips         Payslip[]
  pointAccount     PointAccount?
  pointEntries     PointLedgerEntry[]
  pointReservations PointReservation[]
  incentiveProposals IncentiveProposal[]
  internAccruals   InternAccrual[]
  internSettlements InternSettlement[]
  expenseClaims    ExpenseClaim[]
  obligations      FinancialObligation[]
}

// Event absensi append-only (check_in/check_out) dgn GPS + status validasi server.
model AttendanceEvent {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  kind             String   // check_in, check_out
  businessDate     DateTime
  clientEventId    String? // idempotency key dari klien (offline replay guard)
  claimedAt        DateTime? // waktu klaim klien (untrusted)
  receivedAt       DateTime @default(now())
  lat              Float?
  lng              Float?
  accuracyM        Float?
  locationVerdict  String   @default("unknown") // matched, unmatched, unknown
  validationStatus String   @default("valid") // valid, exception, pending, rejected
  note             String?
  createdAt        DateTime @default(now())

  @@unique([employeeId, clientEventId])
  @@index([employeeId, businessDate])
}

// Izin/sakit/cuti/koreksi absensi.
model LeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   // izin, sakit, cuti, koreksi
  startDate   DateTime
  endDate     DateTime
  reason      String
  evidenceUrl String?
  status      String   @default("pending") // pending, approved, rejected, cancelled
  approvedBy  String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime @default(now())

  @@index([employeeId, status])
}

// Lembur: order + consent + realisasi (bukan sekadar pengajuan).
model OvertimeRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  date            DateTime
  startMinute     Int // menit dari 00:00
  endMinute       Int // boleh >1440 (lintas tengah malam, di-segment per tanggal)
  reason          String
  taskRef         String?
  consent         Boolean  @default(false) // consent staf — atasan TIDAK boleh memberi consent
  requestedBy     String
  status          String   @default("pending") // pending, approved, rejected, verified
  approvedBy      String?
  decidedAt       DateTime?
  realizedMinutes Int? // realisasi faktual (HR verifikasi)
  verifiedBy      String?
  complianceFlag  String? // exception kepatuhan (cap 4j/hari 18j/minggu dsb)
  createdAt       DateTime @default(now())
}

// Perjalanan dinas: order → advance → realisasi → settlement (3 hari kerja utk bukti).
model TravelOrder {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  purpose        String
  projectRef     String?
  destination    String // kota/tujuan — dipakai utk UMK insentif
  departDate     DateTime
  returnDate     DateTime
  advanceAmount  Float    @default(0)
  allowanceDaily Float    @default(0)
  actualAmount   Float?
  status         String   @default("draft") // draft, approved, ongoing, settlement_pending, closed
  settlementStatus String @default("none") // none, return_due, additional_payable, balanced
  settlementDueAt DateTime?
  approvedBy     String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([employeeId, status])
}

// Log pekerjaan harian (kapasitas & basis insentif).
model DailyLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  content    String
  hours      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, date])
}

// Kalender libur (nasional/perusahaan) — klasifikasi hari kerja.
model HolidayCalendar {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String
  kind String   @default("national") // national, company
}

// ============ FASE 6 — COMPENSATION (payroll, poin, insentif, magang) ============

// Periode payroll — cutoff tanggal 21, bayar tanggal 25 (dimajukan bila bukan hari kerja).
model PayrollPeriod {
  id        String   @id @default(cuid())
  name      String   @unique // "2026-09"
  startDate DateTime
  endDate   DateTime // tanggal cutoff (21)
  payDate   DateTime // tanggal pencairan (25, dimajukan)
  status    String   @default("open") // open, locked, finalized
  lockedAt  DateTime?
  createdAt DateTime @default(now())

  runs PayrollRun[]
}

// Run payroll dlm periode (revisi via adjustment run, tidak rewrite slip lama).
model PayrollRun {
  id        String   @id @default(cuid())
  periodId  String
  period    PayrollPeriod @relation(fields: [periodId], references: [id])
  revision  Int      @default(1)
  status    String   @default("draft") // draft, calculated, approved, finalized
  inputHash String?
  note      String?
  createdBy String
  finalizedAt DateTime?
  createdAt DateTime @default(now())

  slips Payslip[]

  @@unique([periodId, revision])
}

// Slip gaji per karyawan per run — immutable setelah finalize.
model Payslip {
  id         String   @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  gross      Float    @default(0)
  deduction  Float    @default(0)
  reimbursement Float @default(0)
  net        Float    @default(0)
  currency   String   @default("IDR")
  status     String   @default("draft") // draft, finalized
  createdAt  DateTime @default(now())

  items PayslipItem[]

  @@unique([runId, employeeId])
}

model PayslipItem {
  id             String  @id @default(cuid())
  payslipId      String
  payslip        Payslip @relation(fields: [payslipId], references: [id])
  componentCode  String // base_salary, allowance, overtime, incentive, point_redemption, stipend, deduction
  label          String
  classification String // earning, deduction, reimbursement
  quantity       Float   @default(1)
  rate           Float   @default(0)
  amount         Float   @default(0)
  sourceRef      String? // trace sumber (id overtime/incentive/reservasi poin/dll)
}

// Rekening poin per karyawan (cache; sumber kebenaran = PointLedgerEntry append-only).
model PointAccount {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Ledger poin append-only: earn / redeem / adjust.
model PointLedgerEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  kind       String // earn, redeem, adjust
  points     Float // earn/adjust positif, redeem negatif
  sourceType String? // task, overtime, travel, project, manual
  sourceRef  String?
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

// Reservasi poin utk pencairan (kelipatan 10) — anti pembayaran ganda:
// available = posted_earned - posted_redeemed - active_reserved.
model PointReservation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  points     Float
  status     String   @default("reserved") // reserved, released, settled
  requestId  String   @unique // idempotency key pencairan
  createdAt  DateTime @default(now())
  settledAt  DateTime?
}

// Proposal insentif (poin dan/atau uang) dari tugas/dinas/proyek — approval dulu baru ledger.
model IncentiveProposal {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  sourceType     String // task, overtime, travel, project, manual
  sourceRef      String?
  proposedPoints Float    @default(0)
  proposedAmount Float    @default(0)
  reason         String
  ruleVersion    String? // snapshot aturan/formula
  status         String   @default("pending") // pending, approved, rejected, paid
  proposedBy     String
  decidedBy      String?
  decidedAt      DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
}

// Akumulasi uang saku magang per hari hadir terverifikasi (unique intern+tanggal).
model InternAccrual {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  businessDate DateTime
  rate       Float
  fraction   Float    @default(1) // 1 = penuh, <1 sebagian
  amount     Float
  status     String   @default("provisional") // provisional, verified, adjusted
  sourceRef  String? // referensi sesi absensi
  createdAt  DateTime @default(now())

  @@unique([employeeId, businessDate])
}

// Penyelesaian uang saku magang (setelah selesai, maksimal satu bulan).
model InternSettlement {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  totalAccrued Float    @default(0)
  paidTotal    Float    @default(0)
  status       String   @default("open") // open, submitted, approved, paid
  dueDate      DateTime?
  approvedBy   String?
  paidAt       DateTime?
  createdAt    DateTime @default(now())
}

// Referensi UMK per wilayah per tahun — basis formula insentif dinas.
model UmkReference {
  id         String @id @default(cuid())
  regionCode String
  regionName String
  year       Int
  amount     Float

  @@unique([regionCode, year])
}

// ============ FASE 7 — FINANCE DEPTH (pengeluaran & pembukuan) ============

// Buku besar — bagan akun.
model Account {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  type   String // asset, liability, equity, revenue, expense
  active Boolean @default(true)
  createdAt DateTime @default(now())

  journalLines JournalLine[]
}

// Jurnal umum — draft editable, posted immutable (koreksi via entry pembalik).
model JournalEntry {
  id         String   @id @default(cuid())
  date       DateTime
  memo       String
  sourceType String?  // invoice, payment, expense, payroll, manual
  sourceId   String?
  status     String   @default("draft") // draft, posted
  postedAt   DateTime?
  createdBy  String
  createdAt  DateTime @default(now())
  periodId   String?
  period     AccountingPeriod? @relation(fields: [periodId], references: [id])

  lines JournalLine[]
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Float   @default(0)
  credit    Float   @default(0)
}

// Klaim reimbursement karyawan (header + item).
model ExpenseClaim {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  title       String
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  totalAmount Float    @default(0)
  status      String   @default("draft") // draft, submitted, approved, rejected, paid
  submittedAt DateTime?
  approvedBy  String?
  decidedAt   DateTime?
  decisionNote String?
  payoutAt    DateTime?
  createdAt   DateTime @default(now())

  items ExpenseItem[]

  @@index([employeeId, status])
}

model ExpenseItem {
  id           String  @id @default(cuid())
  claimId      String
  claim        ExpenseClaim @relation(fields: [claimId], references: [id])
  purchaseDate DateTime
  description  String
  category     String // transport, meals, accommodation, material, other
  amount       Float
  receiptRef   String? // referensi nota/evidence
}

// Periode pembukuan — tutup buku menolak posting baru.
model AccountingPeriod {
  id       String   @id @default(cuid())
  name     String   @unique // "2026-09"
  status   String   @default("open") // open, closed
  closedAt DateTime?
  closedBy String?
  createdAt DateTime @default(now())

  entries JournalEntry[]
}

// Kewajiban finansial terpadu (payroll/reimbursement/poin/settlement magang) — anti double-pay.
model FinancialObligation {
  id              String   @id @default(cuid())
  payeeType       String   @default("employee") // employee, vendor
  payeeEmployeeId String?
  payee           Employee? @relation(fields: [payeeEmployeeId], references: [id])
  payeeName       String
  amount          Float
  currency        String   @default("IDR")
  sourceType      String // payroll, expense, intern_settlement, point_redemption, travel_settlement
  sourceId        String
  status          String   @default("open") // open, paid
  createdAt       DateTime @default(now())

  disbursements CashDisbursement[]

  @@unique([sourceType, sourceId])
}

// Pencairan dana (bukti pembayaran nyata — terpisah dari kewajiban).
model CashDisbursement {
  id           String   @id @default(cuid())
  obligationId String?
  obligation   FinancialObligation? @relation(fields: [obligationId], references: [id])
  payeeName    String
  amount       Float
  method       String   @default("transfer") // transfer, cash
  bankRef      String?
  disbursedAt  DateTime @default(now())
  createdBy    String
  note         String?
}
