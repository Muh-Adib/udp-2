generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ORGANIZATION STRUCTURE ============

model Brand {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  color           String   @default("#f97316") // hex accent
  logoEmoji       String   @default("◆")
  description     String?
  website         String?
  primaryCurrency String   @default("IDR")
  invoicePrefix   String   @default("INV")
  quotePrefix     String   @default("QUO")
  slaHours        Int      @default(4)
  portalDomain    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunities Opportunity[]
  projects      Project[]
  invoices      Invoice[]
  interactions  Interaction[]
  quotations    Quotation[]
  briefs        ClientBrief[]
  channels      ChannelConfig[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   @default("marketing") // super_admin, director, marketing, finance, production, client
  pin         String   @default("1234")
  avatarColor String   @default("#f97316")
  phone       String?
  active      Boolean  @default(true)
  brandAccess String   @default("all") // "all" or comma-separated brand slugs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ IDENTITY (company-centric & contact-centric) ============

model Company {
  id              String    @id @default(cuid())
  name            String
  industry        String?
  website         String?
  websiteDomain   String? // normalized for matching
  country         String?
  city            String?
  address         String?
  size            String? // startup, sme, enterprise, government
  taxId           String?
  defaultCurrency String    @default("IDR")
  lifetimeValue   Float     @default(0)
  tags            String    @default("[]") // JSON array
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  projects      Project[]
  invoices      Invoice[]
  quotations    Quotation[]
  portalTokens  ClientPortalToken[]
  documents     ClientDocument[]
}

model Contact {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String?
  fullName         String // computed & stored for search
  position         String?
  email            String? // normalized lowercase
  emailAlt         String?
  whatsapp         String? // normalized E.164 digits
  phone            String?
  country          String?
  city             String?
  timezone         String?
  language         String    @default("id")
  preferredChannel String    @default("whatsapp") // whatsapp, email, phone, instagram
  socialProfile    String? // handle/URL sosial lain (bebas)
  instagram        String? // handle IG (mis. @rani.creativehouse) — lead kerap datang dari IG
  facebook         String?
  tiktok           String?
  linkedin         String?
  consentStatus    String    @default("granted") // granted, declined, pending
  tags             String    @default("[]") // JSON array
  notes            String?
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  opportunities Opportunity[]
  interactions  Interaction[]
}

// ============ SALES ============

model Opportunity {
  id                String    @id @default(cuid())
  title             String
  brandId           String
  brand             Brand     @relation(fields: [brandId], references: [id])
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id])
  serviceCategory   String? // animation, website, video, immersive...
  serviceName       String?
  leadSource        String? // instagram, whatsapp, email, website, referral, event
  campaign          String?
  brief             String?
  requirements      String?
  targetAudience    String?
  deliverables      String?
  targetDeadline    DateTime?
  estimatedValue    Float?
  currency          String    @default("IDR")
  probability       Int       @default(20)
  expectedCloseDate DateTime?
  ownerName         String?
  priority          String    @default("medium") // low, medium, high, urgent
  stage             String    @default("new") // new, contact_attempted, connected, qualified, discovery, estimation, proposal_sent, negotiation, verbal_agreement, won, lost, nurture
  temperature       String    @default("warm") // hot, warm, cold
  competitor        String?
  nextAction        String?
  nextActionDate    DateTime?
  lostReason        String?
  lostNotes         String?
  lastOfferValue    Float?
  reactivation      Boolean   @default(false)
  followUpDate      DateTime?
  nurtureSegment    String? // reoffer_30, reoffer_90, budget_season, cross_sell, smaller_package, alternative_service
  crossSellOfId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  interactions Interaction[]
  tasks        Task[]
  notes        Note[]
  projects     Project[]
  invoices     Invoice[]
  estimation   Estimation?
  quotations   Quotation[]
  approvals    ApprovalRequest[]
  clientBrief  ClientBrief?
}

model Interaction {
  id             String       @id @default(cuid())
  channel        String // whatsapp, email, instagram, website, phone, meeting, portal
  direction      String // inbound, outbound
  brandId        String?
  externalId     String?
  senderName     String?
  recipientName  String?
  subject        String?
  content        String
  attachments    String? // JSON array
  respondedBy    String?
  respondedAt    DateTime?
  deliveryStatus String? // delivered, read, failed, sent
  deliveryNote   String? // catatan pengiriman nyata (error SMTP, dsb)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  companyId      String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  createdAt      DateTime     @default(now())
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          String       @default("follow_up") // follow_up, meeting, internal, admin
  priority      String       @default("medium") // low, medium, high
  status        String       @default("open") // open, done, cancelled
  assigneeName  String?
  dueDate       DateTime?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Note {
  id            String      @id @default(cuid())
  body          String
  authorName    String
  type          String      @default("internal") // internal, director_feedback
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  createdAt     DateTime    @default(now())
}

// ============ FINANCE ============

model Invoice {
  id              String         @id @default(cuid())
  number          String         @unique
  brandId         String
  brand           Brand          @relation(fields: [brandId], references: [id])
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  changeRequestId String?        @unique
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id])
  description     String?
  amount          Float          @default(0)
  taxRate         Float          @default(11) // PPN %
  taxAmount       Float          @default(0)
  total           Float          @default(0)
  currency        String         @default("IDR")
  status          String         @default("draft") // draft, sent, partial, paid, overdue, cancelled
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    String   @default("transfer") // transfer, cash, qris, credit_card
  reference String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

// ============ PRODUCTION ============

model Project {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id])
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  opportunityId   String?      @unique
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  serviceCategory String?
  status          String       @default("planning") // planning, in_progress, review, completed, cancelled
  progress        Int          @default(0)
  pmName          String?
  startDate       DateTime?
  dueDate         DateTime?
  budgetInternal  Float        @default(0)
  contractValue   Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  milestones    Milestone[]
  invoices      Invoice[]
  changeRequests ChangeRequest[]
  deliverables  ProjectDeliverable[]
}

/**
 * Deliverable & file/tautan untuk direview — alur "kirim file/tautan ke sistem untuk ditinjau".
 * kind: link (url eksternal, contoh Google Drive/Figma) atau file (upload kecil ≤1.2MB, base64 data URL).
 * status: pending (menunggu review) → approved (disetujui) / revision (minta revisi + komentar).
 */
model ProjectDeliverable {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  kind          String   @default("link") // link | file
  url           String? // untuk kind=link
  fileName      String? // untuk kind=file
  fileData      String? // data URL base64 (upload kecil)
  mimeType      String?
  sizeBytes     Int?
  note          String?
  status        String   @default("pending") // pending, approved, revision
  reviewComment String?
  reviewedBy    String?
  reviewedRole  String? // production, director, super_admin, client (siapa yang mereview)
  reviewedAt    DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  name      String
  order     Int       @default(0)
  status    String    @default("pending") // pending, in_progress, done
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

model ChangeRequest {
  id             String    @id @default(cuid())
  number         String    @unique // CR-2026-0001
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  title          String
  description    String
  additionalCost Float     @default(0) // tambahan nilai kontrak (net, sebelum PPN)
  additionalDays Int       @default(0) // perpanjangan deadline (hari kalender)
  status         String    @default("pending") // pending, approved, rejected, cancelled
  requestedBy    String
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?
  invoiceId      String? // invoice tambahan yang dibuat otomatis saat approved
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoice        Invoice?
}

// ============ GOVERNANCE ============

model AuditLog {
  id          String   @id @default(cuid())
  actorName   String
  actorRole   String?
  action      String // create, update, delete, stage_change, merge, login, convert
  entity      String // opportunity, contact, company, task, invoice, project, interaction
  entityId    String
  entityLabel String?
  field       String?
  oldValue    String?
  newValue    String?
  metadata    String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  name      String
  brandId   String?
  channel   String   @default("whatsapp")
  language  String   @default("id")
  stage     String?
  delayDays Int      @default(1)
  body      String
  version   Int      @default(1)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ FASE 2: KOMERSIAL ============

model Estimation {
  id               String      @id @default(cuid())
  opportunityId    String      @unique
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id])
  // Cost breakdown kategori (IDR)
  laborInternal    Float       @default(0)
  vendorFreelance  Float       @default(0)
  equipment        Float       @default(0)
  transport        Float       @default(0)
  accommodation    Float       @default(0)
  talent           Float       @default(0)
  locationFee      Float       @default(0)
  softwareLicense  Float       @default(0)
  hostingDomain    Float       @default(0)
  contingencyPct   Float       @default(5)
  managementFeePct Float       @default(5)
  discountPct      Float       @default(0)
  taxPct           Float       @default(11)
  targetMarginPct  Float       @default(30)
  // Hasil kalkulasi (disimpan saat save)
  totalCost        Float       @default(0)
  contingency      Float       @default(0)
  managementFee    Float       @default(0)
  revenue          Float       @default(0)
  discountAmount   Float       @default(0)
  netRevenue       Float       @default(0)
  taxAmount        Float       @default(0)
  grandTotal       Float       @default(0)
  margin           Float       @default(0)
  marginPct        Float       @default(0)
  notes            String?
  status           String      @default("draft") // draft, pending_approval, approved, rejected
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Quotation {
  id             String      @id @default(cuid())
  number         String      @unique
  brandId        String
  brand          Brand       @relation(fields: [brandId], references: [id])
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  items          String      @default("[]") // JSON [{description, qty, unitPrice, subtotal}]
  subtotal       Float       @default(0)
  discountPct    Float       @default(0)
  discountAmount Float       @default(0)
  taxPct         Float       @default(11)
  taxAmount      Float       @default(0)
  total          Float       @default(0)
  currency       String      @default("IDR")
  status         String      @default("draft") // draft, sent, accepted, rejected, expired
  validUntil     DateTime?
  notes          String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ApprovalRequest {
  id            String       @id @default(cuid())
  entityType    String // estimation, discount, budget
  entityId      String
  entityLabel   String?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  requestedBy   String
  amount        Float?
  discountPct   Float?
  note          String?
  status        String       @default("pending") // pending, approved, rejected
  decidedBy     String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())
}

// ============ NOTIFIKASI (Fase 3) ============
// State baca/dismiss per pengguna; isi notifikasi dikomputasi dari data
// operasional (SLA, approval, CR, task, deadline, invoice) di /api/notifications.
model NotificationState {
  id          String    @id @default(cuid())
  userKey     String // email user (persona demo) — kunci stabilitas per pengguna
  notifKey    String // kunci notifikasi komputasi, mis. "sla:<id>", "cr:<id>"
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userKey, notifKey])
  @@index([userKey])
}

// ============ PREFERENSI PENGGUNA (Fase 3 — sinkron antar perangkat) ============
// KV store preferensi per pengguna; value berupa JSON string.
// Sumber kebenaran lintas perangkat (localStorage hanya cache instan/offline).
model UserPreference {
  id        String   @id @default(cuid())
  userKey   String // email user (persona demo) — kunci stabilitas per pengguna
  key       String // kunci preferensi, mis. "notif-prefs"
  value     String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userKey, key])
  @@index([userKey])
}

// ============ FASE 2: BRIEF BUILDER ============
// Brief terstruktur per opportunity — tahap pertama alur komersial
// (Brief → Estimasi → Quotation). Menggantikan brief teks bebas dgn
// struktur: layanan, tujuan, audiens, deliverables, timeline, budget,
// referensi + alur status draft → in_review → approved / revision.
model ClientBrief {
  id              String      @id @default(cuid())
  code            String      @unique // BRF-2026-0001
  opportunityId   String      @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  brandId         String
  brand           Brand       @relation(fields: [brandId], references: [id])
  title           String
  serviceTypes    String      @default("[]") // JSON array string (katalog layanan brand)
  objectives      String?
  targetAudience  String?
  keyMessages     String?
  deliverables    String      @default("[]") // JSON array [{name, qty, notes}]
  timelineStart   DateTime?
  timelineEnd     DateTime?
  budgetMin       Float?
  budgetMax       Float?
  currency        String      @default("IDR")
  references      String      @default("[]") // JSON array [{label, url}]
  attachmentsNote String?
  status          String      @default("draft") // draft, in_review, approved, revision
  revisionNote    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ============ FASE 3: PORTAL KLIEN — SECURE LINK TOKEN ============
// Akses klien TANPA login: staf membuat token rahasia per perusahaan klien,
// klien membuka URL /?portal=<token>. Token bisa dicabut kapan saja.
model ClientPortalToken {
  id             String    @id @default(cuid())
  token          String    @unique // 48 hex acak — rahasia, hanya dibagikan ke klien
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label          String?   // mis. "Hendra — PT Nusantara"
  active         Boolean   @default(true) // false = dicabut
  createdByName  String?
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

// Isi secure link klien: MoU (file/tautan), catatan rapat (teks), dokumen lain.
// File kecil ≤1.2MB disimpan base64 (praktis utk demo; object storage menyusul).
model ClientDocument {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String    @default("document") // mou | meeting_note | document
  title         String
  content       String?   // isi teks (catatan rapat / deskripsi dokumen)
  url           String?   // tautan eksternal (mis. Google Drive)
  fileName      String?
  fileData      String?   // data URL base64 (upload kecil)
  mimeType      String?
  sizeBytes     Int?
  meetingAt     DateTime? // utk kind=meeting_note
  attendees     String?   // peserta rapat, dipisah koma
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, kind])
}

// ============ FASE 3: SALURAN & INTEGRASI ============
// Koneksi kanal komunikasi (WhatsApp Business, Instagram, Email) per brand
// atau organisasi. Kredensial disimpan JSON dan DIRESPONS TERSENSA oleh API.
// Webhook WhatsApp memakai verifyToken/appSecret dari sini sbg fallback env.
model ChannelConfig {
  id           String    @id @default(cuid())
  channel      String // whatsapp, instagram, email
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id])
  displayName  String
  accountRef   String? // nomor WA / username IG / alamat email
  credentials  String    @default("{}") // JSON per kanal (token, ids, secret)
  status       String    @default("connected") // connected, disconnected, error
  statusNote   String? // hasil test/verifikasi terakhir
  isDemo       Boolean   @default(false) // koneksi demo (kredensial buatan, 1-klik)
  lastEmailSyncAt DateTime? // sinkronisasi IMAP terakhir (kanal email)
  connectedAt  DateTime?
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([channel])
  @@index([brandId])
}
